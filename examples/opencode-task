#!/usr/bin/env python3
"""Reference launcher for Werkbank's local-model worker — ADAPT OR REPLACE.

Werkbank dispatches a ticket with `assignee: opencode` by running:

    opencode-task <project-dir> [model-id]  < task-text-on-stdin

It is deliberately NOT part of the board: which local agent you run, how you
wake it and how you address it is your business. This file is a working
example that satisfies the contract the board relies on, so you have something
that runs before you start changing it.

THE CONTRACT — the board depends on exactly this:

    argv[1]   absolute path of the project to work in (required)
    argv[2]   model id (optional, advisory: this script prefers what the
              endpoint actually serves, so a stale id in a ticket cannot
              break dispatch)
    stdin     the task text, verbatim, UTF-8, possibly tens of kilobytes of
              markdown. Never pass it as an argument: a single argv element
              dies at ~128 KB, and the board found that the hard way.
    stdout    the agent's FINAL text and nothing else. The board copies it
              into the ticket verbatim.
    stderr    diagnostics, progress, the model actually used
    exit 0    success, final text on stdout
    exit 3    the project directory does not exist
    exit 4    the model endpoint is unreachable (box off, engine not loaded)
    exit 5    the agent ran but produced no final text
    other     the agent's own exit code

Two rules that are not obvious and cost the board real downtime:

  * The agent's stdout/stderr must NOT be inherited from this process. A
    background child holding the pipe keeps the board waiting long after the
    work is done — 19 minutes of a stalled queue, once.
  * Nothing may outlive this script. Children are terminated before it exits.

Configuration, all optional, all via environment:

    OPENCODE_BIN       the agent to run          (default: "opencode")
    OPENCODE_ENDPOINT  OpenAI-compatible base    (default: unset — no probe)
    OPENCODE_PROVIDER  provider prefix for the model id, e.g. "vllm-desktop"
    OPENCODE_TIMEOUT   seconds for the whole run (default: 3600)
    OPENCODE_PROBE_TIMEOUT  seconds to wait for the endpoint (default: 60)

Requires only the Python 3 standard library.
"""

from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

BAD_DIRECTORY = 3
ENDPOINT_DOWN = 4
NO_FINAL_TEXT = 5


def log(message: str) -> None:
    """Diagnostics go to stderr — stdout belongs to the result alone."""
    print(f"opencode-task: {message}", file=sys.stderr, flush=True)


def served_model(endpoint: str, deadline: float):
    """First model the endpoint reports, or None.

    Retries until the deadline instead of believing the first empty answer: a
    socket-activated engine accepts the connection while it is still loading
    weights, and concluding "down" from that fails every first ticket after an
    idle period."""
    url = endpoint.rstrip("/") + "/models"
    while time.monotonic() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=10) as response:
                data = json.load(response)
            models = data.get("data") or []
            if models and isinstance(models[0], dict) and models[0].get("id"):
                return str(models[0]["id"])
        except (urllib.error.URLError, OSError, ValueError, json.JSONDecodeError):
            pass
        time.sleep(3)
    return None


def final_text(raw: str) -> str:
    """Last assistant text in the agent's JSON output.

    Accepts both line-delimited JSON and one document, and walks the structure
    instead of pinning a schema — agents change their event shapes."""
    texts: list = []

    def walk(node):
        if isinstance(node, dict):
            if node.get("type") == "text" and isinstance(node.get("text"), str):
                texts.append(node["text"])
            for value in node.values():
                walk(value)
        elif isinstance(node, list):
            for value in node:
                walk(value)

    for line in raw.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            walk(json.loads(line))
        except json.JSONDecodeError:
            pass
    if not texts:
        try:
            walk(json.loads(raw))
        except json.JSONDecodeError:
            pass
    return texts[-1].strip() if texts else ""


def end_process_tree(proc) -> None:
    """Terminate the run AND whatever it started. A stray child holding a pipe
    is how a finished run keeps a board busy."""
    if proc.poll() is not None:
        return
    try:
        os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
    except OSError:
        proc.terminate()
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        except OSError:
            proc.kill()


def main(argv) -> int:
    if len(argv) < 2:
        log("usage: opencode-task <project-dir> [model-id] < task.txt")
        return 2
    project = argv[1]
    wanted_model = argv[2] if len(argv) > 2 else ""

    if not os.path.isdir(project):
        log(f"no such directory: {project}")
        return BAD_DIRECTORY

    task = sys.stdin.read()          # verbatim, however long
    if not task.strip():
        log("empty task on stdin — refusing to run the model on nothing")
        return NO_FINAL_TEXT

    model = wanted_model
    endpoint = os.environ.get("OPENCODE_ENDPOINT", "").strip()
    if endpoint:
        probe = float(os.environ.get("OPENCODE_PROBE_TIMEOUT", "60"))
        actually = served_model(endpoint, time.monotonic() + probe)
        if not actually:
            log(f"endpoint unreachable or serving nothing: {endpoint}")
            return ENDPOINT_DOWN
        if wanted_model and wanted_model != actually:
            log(f"WARNING requested {wanted_model!r} but endpoint serves "
                f"{actually!r}; using what is served")
        model = actually

    provider = os.environ.get("OPENCODE_PROVIDER", "").strip()
    agent = os.environ.get("OPENCODE_BIN", "opencode")
    cmd = [agent, "run", "--dir", project, "--format", "json"]
    if model:
        cmd += ["--model", f"{provider}/{model}" if provider else model]
    log(f"model={model or 'default'} dir={project}")

    # The agent's output goes to FILES, never to our own descriptors: a stray
    # child cannot then hold the caller's pipe open and stall the board.
    with tempfile.TemporaryDirectory(prefix="opencode-task-") as scratch:
        out_path = os.path.join(scratch, "out")
        err_path = os.path.join(scratch, "err")
        try:
            with open(out_path, "wb") as out, open(err_path, "wb") as err:
                # The task goes on the AGENT's stdin too, for the same
                # reason it reaches us that way: as an argument it dies at
                # ~128 KB, and a truncated task looks like a stupid model.
                proc = subprocess.Popen(
                    cmd, stdout=out, stderr=err, stdin=subprocess.PIPE,
                    start_new_session=True)   # own process group, see above
                try:
                    proc.stdin.write(task.encode("utf-8"))
                except (BrokenPipeError, OSError):
                    pass                      # agent closed stdin early
                finally:
                    try:
                        proc.stdin.close()
                    except OSError:
                        pass
                try:
                    code = proc.wait(timeout=float(
                        os.environ.get("OPENCODE_TIMEOUT", "3600")))
                except subprocess.TimeoutExpired:
                    log("timeout — ending the run and everything it started")
                    end_process_tree(proc)
                    code = 124
        except FileNotFoundError:
            log(f"agent not found: {agent} (set OPENCODE_BIN)")
            return 127
        finally:
            try:
                end_process_tree(proc)        # nothing outlives this script
            except NameError:
                pass

        raw = open(out_path, encoding="utf-8", errors="replace").read()
        # Forward what the agent said about itself — bounded, so a chatty run
        # cannot flood the board's log, but never silently dropped: on a
        # confusing result this is the only trace of what happened.
        noise = open(err_path, encoding="utf-8", errors="replace").read().splitlines()
        if len(noise) > 50:
            log(f"… {len(noise) - 50} earlier line(s) of agent output omitted")
            noise = noise[-50:]
        for line in noise:
            print(line, file=sys.stderr)
        answer = final_text(raw)
        if not answer:
            log(f"no final text (agent exit {code}) — its output is above")
            return NO_FINAL_TEXT if code == 0 else code

    print(answer)                    # stdout: the result, nothing else
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
